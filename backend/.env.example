# Gnani AI + OpenRouter keys. Server-side only - never in frontend code.
# Gnani: https://app.gnani.ai/ generate under API keys (programme credits come by email)
GNANI_API_KEY=vach_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter: https://openrouter.ai/settings/keys (starts with sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which OpenRouter model drives the agent (any tool-calling chat model works).
# Default: nvidia/nemotron-3.5-super-vl:free - free, fast (~0.7 s), reliable
# tool calls. The backend sends reasoning: {enabled: false} so reasoning-heavy
# models never eat the token budget and go silent.
# Other options: openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct,
# nvidia/nemotron-3.5-lightning:free (faster, smaller).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Gnani Timbre v3.0 voice (each voice speaks all 10 languages).
# Others: Shivani, Lakshmi, Kalpana, Chetana, Vasudha, Riyaa, Tarika,
#         Avinash, Shubham, Prakash, Devansh, Yashraj, Harshad
GNANI_TTS_VOICE=Shivani

# Shared secret tools send as X-Tool-Secret
TOOL_SECRET=machinery-dev
